<view class="page"><view class="section-title">可重复使用的个人规则</view><picker range="{{sources}}" range-key="name" value="{{index}}" bindchange="source"><view class="card panel">{{sources[index].name || '尚无来源，可先设置课程并展开'}} ▾</view></picker>
  <view class="card panel"><view class="section-title">来源班次</view><input class="field" value="{{name}}" data-field="name" bindinput="field" placeholder="来源名称" /><view class="notice">仅用于所选来源；原表明确时间优先，个人修正继续保留。</view><view wx:for="{{shifts}}" wx:key="index" class="field">{{item.name}} · {{item.aliases}} · {{item.start}}–{{item.next_day ? '次日' : ''}}{{item.end}}<button class="secondary" data-index="{{index}}" bindtap="removeShift">移除此规则</button></view><input class="field" data-field="shiftName" bindinput="field" placeholder="班次名称，如早班" /><input class="field" data-field="aliases" bindinput="field" placeholder="符号或别名，用顿号分开，如早、早班" /><picker mode="time" data-field="start" bindchange="field"><view class="field">开始：{{start || '选择'}}</view></picker><picker mode="time" data-field="end" bindchange="field"><view class="field">结束：{{end || '选择'}}</view></picker><view class="field">次日结束 <switch checked="{{nextDay}}" data-field="nextDay" bindchange="field" /></view><button class="secondary" bindtap="addShift">加入规则草稿</button></view>
  <view class="card panel"><view class="section-title">课程与学期</view><picker mode="date" value="{{monday}}" data-field="monday" bindchange="field"><view class="field">第一教学周周一：{{monday || '选择'}}</view></picker><input class="field" type="number" value="{{weeks}}" data-field="weeks" bindinput="field" placeholder="学期周数" /><view class="muted">每行一个节次，按顺序填写，如 08:00-08:45</view><textarea value="{{periodsText}}" data-field="periodsText" bindinput="field" maxlength="2000" /><view class="notice">不自动推断法定节假日停课或调课。单次调课请展开后修改那一天的安排。</view></view>
  <view wx:if="{{sources.length}}" class="card panel"><view class="section-title">表格模板</view><view class="muted">{{templateSaved ? '已有模板草稿' : '指定表头行与字段列，保存后在相同来源导入中复用'}}</view><picker range="{{tableSheets}}" range-key="label" data-field="sheetIndex" bindchange="field"><view class="field">预览：{{tableSheets[sheetIndex].label || '暂无可用表格'}}</view></picker><scroll-view scroll-x><view class="grid-preview"><view class="grid-row" wx:for="{{tablePreview}}" wx:for-item="row" wx:key="index"><text wx:for="{{row}}" wx:for-item="cell" wx:key="cell">{{cell.cell}} {{cell.text}}</text></view></view></scroll-view><picker range="{{layouts}}" value="{{templateLayout}}" data-field="templateLayout" bindchange="field"><view class="field">{{layouts[templateLayout]}}</view></picker><view class="muted">行和列编号从 1 开始。矩阵表中姓名列/行与日期行/列使用对应编号。</view><view class="field">表头行<input type="number" value="{{headerRow}}" data-field="headerRow" bindinput="field" /></view><view class="field">姓名列 / 行<input type="number" value="{{nameColumn}}" data-field="nameColumn" bindinput="field" /></view><view class="field">日期列 / 行<input type="number" value="{{dateColumn}}" data-field="dateColumn" bindinput="field" /></view><view class="field">事项列<input type="number" value="{{titleColumn}}" data-field="titleColumn" bindinput="field" /></view><view class="field">时间列<input type="number" value="{{timeColumn}}" data-field="timeColumn" bindinput="field" /></view><button class="secondary" bindtap="template">记录当前表头与映射</button></view>
  <view wx:if="{{revisions.length}}" class="card panel"><view class="section-title">最近的来源版本</view><view class="field" wx:for="{{revisions}}" wx:key="id"><view>{{item.importedAt}}</view><view class="muted">{{item.coverage}} · {{item.files}}</view></view></view>
  <button wx:if="{{sources.length}}" class="primary" bindtap="preview" loading="{{busy}}" disabled="{{busy}}">预览规则影响并保存</button><view wx:if="{{preview !== null}}" class="card panel"><view class="section-title">影响 {{preview.length}} 条安排</view><view wx:for="{{preview}}" wx:key="id" class="field">{{item.before}} → {{item.after}}</view><button class="primary" bindtap="save">确认规则和批量应用</button></view>
  <view class="card panel"><view class="section-title">展开一门课程</view><input class="field" data-field="courseTitle" bindinput="field" placeholder="课程名称" /><input class="field" data-field="location" bindinput="field" placeholder="教室" /><view class="field">星期（1–7）<input type="number" value="{{weekday}}" data-field="weekday" bindinput="field" /></view><view class="field">开始节次<input type="number" value="{{periodFrom}}" data-field="periodFrom" bindinput="field" /></view><view class="field">结束节次<input type="number" value="{{periodTo}}" data-field="periodTo" bindinput="field" /></view><view class="field">开始周<input type="number" value="{{weekFrom}}" data-field="weekFrom" bindinput="field" /></view><view class="field">结束周<input type="number" value="{{weekTo}}" data-field="weekTo" bindinput="field" /></view><picker range="{{parityLabels}}" data-field="parity" bindchange="field"><view class="field">{{parityLabels[parity]}} ▾</view></picker><input class="field" data-field="specificWeeks" bindinput="field" placeholder="指定周次（可选，如1、3、8，优先于范围）" /><button class="primary" bindtap="course" disabled="{{busy}}">展开实际日期并核对</button></view><view wx:if="{{error}}" class="error">{{error}}</view>
</view>
