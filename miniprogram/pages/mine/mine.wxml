<view class="page {{large ? 'large' : ''}}"><view class="section-title">我的星程</view><view class="card panel"><input class="field" value="{{name}}" data-field="name" bindinput="field" placeholder="你的完整姓名" maxlength="80" /><button class="secondary" bindtap="switchPerson">建立 / 切换个人日历</button><view class="muted">不同姓名的安排分别管理。切换前请保存备份。</view></view>
  <block wx:if="{{hasCalendar}}"><button class="secondary" bindtap="rules">班次、课程与来源模板</button>
    <view class="card panel"><view class="section-title">显示设置</view><view class="field">大字号 <switch checked="{{large}}" data-field="large" bindchange="field" /></view><view class="field">隐藏休息日 <switch checked="{{hideRest}}" data-field="hideRest" bindchange="field" /></view><input class="field" value="{{colorCategory}}" data-field="colorCategory" bindinput="field" placeholder="设置颜色的分类" /><picker range="{{colors}}" value="{{colorIndex}}" data-field="colorIndex" bindchange="field"><view class="field" style="color:{{colors[colorIndex]}}">分类颜色：{{colors[colorIndex]}} ▾</view></picker><button class="secondary" bindtap="settings" disabled="{{busy}}">保存显示设置</button></view>
    <view class="card panel"><view class="section-title">本机备份</view><view class="muted">{{savedAt}} · 离线可查看和导出备份</view><view class="actions"><button class="secondary" bindtap="backup">导出并分享备份</button><button class="secondary" bindtap="restoreBackup">从聊天恢复备份</button></view><button wx:if="{{canUndo}}" class="secondary" bindtap="undo" disabled="{{busy}}">撤销最近一次来源更新</button></view>
    <view class="card panel"><view class="section-title">导出日历 ICS</view><picker mode="date" value="{{from}}" data-field="from" bindchange="field"><view class="field">开始日期：{{from || '不限'}}</view></picker><picker mode="date" value="{{to}}" data-field="to" bindchange="field"><view class="field">结束日期：{{to || '不限'}}</view></picker><input class="field" value="{{category}}" data-field="category" bindinput="field" placeholder="分类（空白为全部）" /><picker range="{{sources}}" range-key="name" value="{{sourceIndex}}" data-field="sourceIndex" bindchange="field"><view class="field">{{sources[sourceIndex].name}} ▾</view></picker><picker range="{{alarms}}" value="{{alarmIndex}}" data-field="alarmIndex" bindchange="field"><view class="field">{{alarms[alarmIndex]}} ▾</view></picker><button class="primary" bindtap="export" disabled="{{busy}}" loading="{{busy}}">生成并分享 ICS 文件</button><view class="muted">仅导出已确认安排。缺少时间时请在日程详情补全，或明确设为全天。</view><view class="notice">这是静态文件。保存或分享文件后，使用手机日历的“导入”功能或支持 ICS 的应用打开。各手机的重复导入、更新和提醒行为尚待真机验证，导出不代表自动同步。</view></view>
    <view wx:if="{{hidden.length}}" class="card panel"><view class="section-title">已隐藏的安排</view><view class="field" wx:for="{{hidden}}" wx:key="id">{{item.date}} {{item.title}}<button class="secondary" data-id="{{item.id}}" bindtap="restoreHidden" disabled="{{busy}}">恢复显示</button></view></view>
    <button class="secondary" bindtap="clear" disabled="{{busy}}">清除当前日历</button>
  </block><view class="error" wx:if="{{error}}">{{error}}</view>
</view>
