.brand { display: flex; align-items: center; gap: 14rpx; }
.brand-mark { width: 57rpx; height: 57rpx; background: #6a59d7; color: #fff; text-align: center; line-height: 57rpx; border-radius: 18rpx; font-size: 40rpx; }
.brand-name { font-weight: 700; font-size: 35rpx; letter-spacing: 3rpx; }
.brand-caption { margin-left: auto; color: #9298aa; font-size: 22rpx; }
.hero { padding: 30rpx 0 28rpx; }
.hero-title { font-size: 40rpx; font-weight: 700; line-height: 1.4; }
.hero-copy { color: #626b82; font-size: 28rpx; line-height: 1.8; margin-top: 6rpx; }
.hero-stars { position: absolute; right: 8rpx; top: 95rpx; color: #c9c2f3; font-size: 110rpx; transform: rotate(10deg); }
.hero-stars text { position: absolute; top: 122rpx; right: 54rpx; font-size: 30rpx; color: #a99cdf; }
.form-card { padding: 32rpx; }
.field-label { display: flex; align-items: center; font-size: 28rpx; font-weight: 600; gap: 15rpx; }
.step { display: inline-flex; align-items: center; justify-content: center; width: 35rpx; height: 35rpx; border-radius: 11rpx; background: #f0edfc; color: #7564c7; font-size: 22rpx; }
.name-input { height: 94rpx; background: #f7f8fc; border: 2rpx solid #e8e9f2; border-radius: 18rpx; padding: 0 24rpx; margin-top: 22rpx; font-size: 30rpx; }
.name-tip { margin-top: 12rpx; }
.second { margin-top: 36rpx; }
.file-count { margin-left: auto; color: #9298aa; font-size: 22rpx; font-weight: 400; }
.upload-zone { margin-top: 22rpx; padding: 24rpx 10rpx; border: 2rpx dashed #cdc7ec; border-radius: 20rpx; background: #faf9ff; line-height: 1.6; }
.upload-icon { margin: 0 auto 8rpx; color: #7563cd; font-size: 42rpx; line-height: 1; }
.upload-title { color: #6757b2; font-size: 26rpx; font-weight: 500; }
.file-row { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #edf0f6; gap: 16rpx; }
.file-icon { flex-shrink: 0; width: 52rpx; height: 62rpx; line-height: 62rpx; text-align: center; background: #eaf5f0; color: #528d78; border-radius: 10rpx; font-size: 23rpx; }
.file-info { min-width: 0; flex: 1; }
.file-name { word-break: break-all; font-size: 25rpx; }
.file-error { color: #b34343; font-size: 23rpx; }
.remove { margin: 0; padding: 0 12rpx; color: #9ca1b0; background: transparent; font-size: 34rpx; }
.year-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 28rpx; }
.year-label { font-size: 24rpx; }
.year-input { width: 128rpx; height: 68rpx; border-radius: 14rpx; background: #f4f5fa; text-align: center; font-size: 27rpx; flex-shrink: 0; }
.limits { font-size: 21rpx; margin-top: 24rpx; }
.submit { margin-top: 28rpx; }
.page-error { margin-top: 24rpx; }
.partial { margin-top: 18rpx; }
.footer-note { text-align: center; color: #999eb0; font-size: 22rpx; line-height: 1.8; margin-top: 27rpx; }
.saved-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 24rpx; margin-bottom: 24rpx; background: #f0edfc; border-color: #e1dbf7; }
.saved-card > view { flex: 1; min-width: 0; }
.saved-title { font-size: 26rpx; font-weight: 600; word-break: break-all; }
.resume-button { margin: 0; padding: 0 20rpx; flex-shrink: 0; background: #fff; color: #5e4db0; font-size: 24rpx; border-radius: 14rpx; }
.storage-notice { margin-bottom: 24rpx; }
.clear-saved { color: #626b82; background: transparent; margin-top: 12rpx; font-size: 24rpx; }
.brand-caption, .file-count, .footer-note { color: #687187; font-size: 24rpx; }
.limits { font-size: 24rpx; }
