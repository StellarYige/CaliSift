.review-title { font-size: 42rpx; font-weight: 700; }
.intro { margin: 14rpx 0 28rpx; }
.edit-card { padding: 8rpx 28rpx 28rpx; }
.label { display: flex; align-items: center; gap: 16rpx; margin: 28rpx 0 14rpx; font-weight: 600; }
.required, .optional { font-size: 23rpx; color: #626b82; font-weight: 400; }
.required { color: #6a59b8; background: #f1eefc; padding: 3rpx 10rpx; border-radius: 8rpx; }
.control { width: 100%; min-height: 84rpx; height: 84rpx; padding: 18rpx; border: 2rpx solid #e5e6ef; background: #f8f9fd; border-radius: 14rpx; font-size: 28rpx; }
.picker { display: flex; justify-content: space-between; align-items: center; }
.picker text { font-size: 24rpx; color: #6654b6; }
.time-fields { display: flex; gap: 20rpx; }
.time-field { flex: 1; min-width: 0; }
.time-field .control { margin-top: 8rpx; text-align: center; }
.text-button { background: transparent; font-size: 23rpx; color: #6557b8; padding: 0; margin: 8rpx 0 0; }
.switch-row { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; font-size: 26rpx; }
.notes { min-height: 150rpx; line-height: 1.6; }
.invalid { border-color: #bb5151; }
.field-error { color: #ae3535; font-size: 24rpx; line-height: 1.6; margin-top: 10rpx; }
.field-warning { color: #8b622b; font-size: 24rpx; margin-top: 16rpx; }
.evidence-card { padding: 24rpx; margin-top: 24rpx; }
.evidence-toggle { display: flex; justify-content: space-between; font-size: 26rpx; }
.evidence-toggle text { color: #6557b8; font-size: 24rpx; }
.evidence-item { font-size: 24rpx; color: #626b82; line-height: 1.7; margin-top: 20rpx; border-top: 1rpx solid #edeef5; padding-top: 16rpx; word-break: break-all; }
.excerpt { white-space: pre-wrap; }
.evidence-note { margin-top: 20rpx; }
.save-button, .save-error { margin-top: 28rpx; }
.cancel-button { margin-top: 18rpx; }
